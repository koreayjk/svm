{
  "appId": "com.imamerica.svm",
  "appName": "SVM",
  "webDir": "www",
  "backgroundColor": "#F4F5F8",
  "ios": {
    "contentInset": "never",
    "scheme": "SVM"
  },
  "android": {
    "backgroundColor": "#F4F5F8"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#F4F5F8",
      "showSpinner": false
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
